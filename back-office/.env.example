# Adresse de l'API (backend), sans barre finale.
VITE_API_URL="http://localhost:4000"

# Adresse du site public : bouton « Voir le site » et lien « Retour au site public ».
VITE_PUBLIC_SITE_URL="http://localhost:5173"

# true = faux backend d'authentification (src/api/mockAuth.js), pour travailler
# sans lancer l'API. Identifiants : squad / orienta2026. Jamais en production.
VITE_USE_MOCK_AUTH=false

# true = faux backend des cours (src/api/mockCours.js), pour le développement uniquement.
VITE_USE_MOCK_API=false
