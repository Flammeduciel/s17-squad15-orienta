# Copier ce fichier en .env pour le développement local (`npm run dev` le lit).

# Base PostgreSQL. Sans cette variable, l'API démarre mais /health indique
# "database": "not_configured".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orienta"

NODE_ENV=development
PORT=4000

# Secret de signature des jetons de connexion — à remplacer en production.
JWT_SECRET="change-me-in-production"

# Interfaces autorisées à appeler l'API, séparées par des virgules, sans slash
# final. Ici les deux serveurs Vite : site public et back-office.
# Pas encore appliqué : pendant le développement, l'API accepte toutes les
# origines (voir src/middlewares/cors.js).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Dossier des images déposées (par défaut : backend/uploads) et taille maximale
# d'une image en octets (par défaut : 2 Mo).
# UPLOAD_DIR="./uploads"
# MAX_UPLOAD_BYTES=2097152
