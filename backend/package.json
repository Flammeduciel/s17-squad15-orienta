{
  "name": "orienta-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Orienta — orientation des nouveaux bacheliers vers les instituts privés de Brazzaville",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/migrate.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/seed.sql",
    "db:reset": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/reset.sql"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
